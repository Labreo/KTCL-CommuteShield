# ==============================================================================
# KTCL CommuteShield - Environment Configuration Template
# Copy this file to .env and fill in your values. DO NOT commit .env to git!
# ==============================================================================

# KTCL Smart Card Configuration
KTCL_CARD_NUMBER=ST2500000000
KTCL_CARDHOLDER_NAME="Student Name"
KTCL_CARD_TYPE=STUDENT

# Commuter Settings
COMMUTER_NAME=Tejas
COMMUTER_HOME_HUB=Margao
COMMUTER_CAMPUS_HUB=Farmagudi
COMMUTER_ALERT_TIME_IST="20:00"

# SerpApi Key (for live Goa route, monsoon flood & transit disruption grounding)
# Get a free key at https://serpapi.com
SERPAPI_API_KEY=

# Prior Labs TabPFN API Key / Token (for TabPFN tabular foundation model)
# Get a free key at https://ux.priorlabs.ai/account
TABPFN_TOKEN=

# Notification Configuration (Optional - defaults to Rich terminal console)
# For Telegram notifications:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# For Twilio / WhatsApp Cloud API:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
